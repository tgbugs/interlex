#!/usr/bin/env bash
# interlex-dbsetup [--pguri|--no-pguri] [PORT] [DATABASE] [HOST]
set -e

USE_PGURI=""
POSARGS=()
for _arg in "$@"; do
    case "$_arg" in
        --pguri)    USE_PGURI=1 ;;
        --no-pguri) USE_PGURI=0 ;;
        *)          POSARGS+=("$_arg") ;;
    esac
done
set -- "${POSARGS[@]}"

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do # resolve all symlinks
  DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE" # resolve relative symlinks
done
ABS_PATH="$( cd -P "$( dirname "$SOURCE" )" && pwd )"

SQL="${ABS_PATH}/../sql"
RESOURCES="${ABS_PATH}/../resources/"
PATH_TEST="${ABS_PATH}/../test"

if [ ! -d "${SQL}" ]; then
  # installed outside of git
  SQL="${ABS_PATH}/../share/interlex/sql"
  RESOURCES="${ABS_PATH}/../share/interlex/resources/"
  PATH_TEST="${ABS_PATH}/../share/interlex/test"
fi

if [ -z $1 ]; then
    PORT=$(python -c 'from interlex.config import auth; print(auth.get("test-port"))')
else
    PORT=$1
fi

if [ -z $2 ]; then
    DATABASE=$(python -c 'from interlex.config import auth; print(auth.get("test-database"))')
else
    DATABASE=$2
fi

if [ -z $3 ]; then
    HOST=localhost
else
    HOST=$3
fi

if [ -z "${USE_PGURI}" ]; then
    USE_PGURI=0
fi
if [ "${USE_PGURI}" = "1" ]; then
    URI_SQL="${SQL}/extensions-pguri.sql"
else
    URI_SQL="${SQL}/pguri_sql.sql"
fi

echo running dbsetup for ${DATABASE} on ${HOST}:${PORT}


# postgres setup (these need to fail loudly)
psql -U postgres -h ${HOST} -p ${PORT} -d postgres  -f "${SQL}/postgres.sql" -v ON_ERROR_STOP=on -v database=$DATABASE

psql -U postgres -h ${HOST} -p ${PORT} -d ${DATABASE} -f "${URI_SQL}" -v ON_ERROR_STOP=on
psql -U postgres -h ${HOST} -p ${PORT} -d ${DATABASE} -f "${SQL}/extensions.sql" -v ON_ERROR_STOP=on

# interlex-admin setup
psql -U interlex-admin -h ${HOST} -p ${PORT} -d ${DATABASE} -f "${SQL}/schemas.sql" -v ON_ERROR_STOP=on
psql -U interlex-admin -h ${HOST} -p ${PORT} -d ${DATABASE} -f "${SQL}/groups.sql" -v ON_ERROR_STOP=on
psql -U interlex-admin -h ${HOST} -p ${PORT} -d ${DATABASE} -f "${SQL}/triples.sql" -v ON_ERROR_STOP=on
psql -U interlex-admin -h ${HOST} -p ${PORT} -d ${DATABASE} -f "${SQL}/user-uris.sql" -v ON_ERROR_STOP=on
psql -U interlex-admin -h ${HOST} -p ${PORT} -d ${DATABASE} -f "${SQL}/pulls.sql" -v ON_ERROR_STOP=on
psql -U interlex-admin -h ${HOST} -p ${PORT} -d ${DATABASE} -f "${SQL}/comments.sql" -v ON_ERROR_STOP=on
psql -U interlex-admin -h ${HOST} -p ${PORT} -d ${DATABASE} -f "${SQL}/inserts.sql" -v ON_ERROR_STOP=on -v resources=${RESOURCES}
psql -U interlex-admin -h ${HOST} -p ${PORT} -d ${DATABASE} -f "${SQL}/permissions.sql" -v ON_ERROR_STOP=on -v database=${DATABASE}

# tests
export DBSETUPTEST=1
# FIXME only run tests if we are on testing database probably to avoid pollution?
export INTERLEX_TEST_PORT=${PORT}
export INTERLEX_TEST_DATABASE=${DATABASE}
echo running python tests 
pytest "${PATH_TEST}"/test_constraints.py
unset DBSETUPTEST
unset INTERLEX_TEST_PORT
unset INTERLEX_TEST_DATABASE
